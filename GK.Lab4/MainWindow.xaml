<Window x:Class="GK.Lab4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GK.Lab4 - Michal Grochowski" Height="850" Width="1400">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderBrush="Black" BorderThickness="1" Margin="10">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Image x:Name="DisplayImage" Stretch="Uniform"/>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Column="1" Margin="10">
            <Button Content="Load Image" Click="LoadImage_Click" Margin="0,0,0,10" Height="30"/>

            <TextBlock Text="Point Transformations" FontWeight="Bold" FontSize="14" Margin="0,5,0,0"/>
            <TextBox x:Name="ValueInput" Margin="0,5,0,5" Text="50" ToolTip="User Value for Arithmetic/Brightness"/>

            <WrapPanel Margin="0,5,0,5">
                <Button Content="Add" Click="ArithmeticOperation_Click" Tag="Add" Width="70" Margin="2"/>
                <Button Content="Subtract" Click="ArithmeticOperation_Click" Tag="Sub" Width="70" Margin="2"/>
                <Button Content="Multiply" Click="ArithmeticOperation_Click" Tag="Mul" Width="70" Margin="2"/>
                <Button Content="Divide" Click="ArithmeticOperation_Click" Tag="Div" Width="70" Margin="2"/>
                <Button Content="Brightness" Click="Brightness_Click" Width="70" Margin="2"/>
            </WrapPanel>

            <Button Content="Grayscale (Average)" Click="GrayscaleAvg_Click" Margin="0,5,0,5"/>
            <Button Content="Grayscale (Weighted)" Click="GrayscaleWeighted_Click" Margin="0,0,0,10"/>

            <Separator Margin="0,10"/>

            <TextBlock Text="Image Filters" FontWeight="Bold" FontSize="14" Margin="0,5,0,0"/>
            <WrapPanel Margin="0,5,0,5">
                <Button Content="Smoothing (Average)" Click="Filter_Click" Tag="Average" Width="120" Margin="2"/>
                <Button Content="Median Filter" Click="Filter_Click" Tag="Median" Width="120" Margin="2"/>
                <Button Content="Sobel (Edge Detection)" Click="Filter_Click" Tag="Sobel" Width="120" Margin="2"/>
                <Button Content="Sharpening Filter" Click="Filter_Click" Tag="Sharpen" Width="120" Margin="2"/>
                <Button Content="Gaussian Blur" Click="Filter_Click" Tag="Gauss" Width="120" Margin="2"/>
            </WrapPanel>

            <Separator Margin="0,10"/>

            <TextBlock Text="Custom" FontWeight="Bold" FontSize="14" Margin="0,5,0,0"/>

            <Grid Margin="0,5,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Kernel Height:" FontWeight="SemiBold" Margin="0,0,0,2"/>
                    <TextBox x:Name="KernelHeightInput" Text="3"
                             ToolTip="Height of kernel (must be odd: 3, 5, 7, 9, 11)"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Kernel Width:" FontWeight="SemiBold" Margin="0,0,0,2"/>
                    <TextBox x:Name="KernelWidthInput" Text="3"
                             ToolTip="Width of kernel (must be odd: 3, 5, 7, 9, 11)"/>
                </StackPanel>
            </Grid>

            <Button Content="Open Editor" Click="OpenKernelEditor_Click"
                    Margin="0,5,0,5" Height="35" Background="LightBlue"
                    ToolTip="Opens interactive dialog to create and edit custom kernel matrix"/>

        </StackPanel>
    </Grid>
</Window>