<Window x:Class="GK.Lab4.KernelEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kernel Editor" Height="600" Width="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ScrollViewer containing the kernel grid -->
        <ScrollViewer Grid.Row="0"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Margin="0,0,0,15">
            <Grid x:Name="KernelGrid"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"/>
        </ScrollViewer>

        <!-- Normalization Factor Input -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
            <TextBlock Text="Normalization Factor:"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Margin="0,0,10,0"/>
            <TextBox x:Name="NormalizationFactorInput"
                     Width="100"
                     Text="1"
                     ToolTip="Divisor for convolution result. Use 1 for no normalization, or kernel sum for averaging filters"
                     VerticalContentAlignment="Center"/>
        </StackPanel>

        <!-- Button Panel -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    Width="110"
                    Height="30"
                    Margin="0,0,10,0"
                    Click="CancelButton_Click"
                    IsCancel="True"/>
            <Button x:Name="ApplyButton"
                    Content="Apply"
                    Width="110"
                    Height="30"
                    Click="ApplyButton_Click"
                    IsDefault="True"
                    Background="LightGreen"/>
        </StackPanel>
    </Grid>
</Window>
