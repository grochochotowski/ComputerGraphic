<Window x:Class="GK.Lab1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GK.Lab1"
        mc:Ignorable="d"
        Title="Proj 1" Height="720" Width="1280">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- toolbar -->
            <RowDefinition Height="*"/> <!-- canvas -->
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <ScrollViewer Grid.Row="0"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal" Margin="8">

                <!-- Tools -->
                <Button Content="Select"    Click="ToolSelect_Click"  Margin="0,0,8,0"/>
                <Button Content="Line"      Click="ToolLine_Click"    Margin="0,0,8,0"/>
                <Button Content="Rectangle" Click="ToolRect_Click"    Margin="0,0,8,0"/>
                <Button Content="Circle"    Click="ToolCircle_Click"  Margin="0,0,8,0"/>

                <!-- Separator -->
                <Separator Margin="12,0,12,0" Width="1" Height="24" VerticalAlignment="Center"/>

                <!-- LINE params -->
                <StackPanel x:Name="PanelLine" Orientation="Horizontal">
                    <TextBlock Text="X1:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="TbX1" Width="60" Margin="0,0,8,0" Text="100"/>
                    <TextBlock Text="Y1:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="TbY1" Width="60" Margin="0,0,8,0" Text="100"/>
                    <TextBlock Text="X2:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="TbX2" Width="60" Margin="0,0,8,0" Text="300"/>
                    <TextBlock Text="Y2:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="TbY2" Width="60" Margin="0,0,8,0" Text="200"/>
                </StackPanel>

                <!-- RECT params -->
                <StackPanel x:Name="PanelRect" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Text="Left:" VerticalAlignment="Center" Margin="12,0,4,0"/>
                    <TextBox x:Name="TbLeft" Width="60" Margin="0,0,8,0" Text="100"/>
                    <TextBlock Text="Top:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="TbTop" Width="60" Margin="0,0,8,0" Text="100"/>
                    <TextBlock Text="W:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="TbWidth" Width="60" Margin="0,0,8,0" Text="200"/>
                    <TextBlock Text="H:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="TbHeight" Width="60" Margin="0,0,8,0" Text="120"/>
                </StackPanel>

                <!-- CIRCLE params -->
                <StackPanel x:Name="PanelCircle" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Text="Cx:" VerticalAlignment="Center" Margin="12,0,4,0"/>
                    <TextBox x:Name="TbCx" Width="60" Margin="0,0,8,0" Text="200"/>
                    <TextBlock Text="Cy:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="TbCy" Width="60" Margin="0,0,8,0" Text="200"/>
                    <TextBlock Text="R:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="TbR" Width="60" Margin="0,0,8,0" Text="80"/>
                </StackPanel>
                
                <!-- Controls -->
                <Button Content="Apply" Click="ApplyParams_Click" Margin="12,0,8,0"/>
                <Button Content="Clear" Click="ClearCanvas_Click" Margin="0,0,8,0"/>
                <Button Content="Save" Click="SaveCanvas_Click" Margin="0,0,8,0"/>
                <Button Content="Load" Click="LoadCanvas_Click" Margin="0,0,8,0"/>

            </StackPanel>
        </ScrollViewer>

        <!-- Canvas -->
        <Canvas x:Name="DrawCanvas" Grid.Row="1" Background="#FFF5F5F5"
                MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                MouseLeftButtonUp="Canvas_MouseLeftButtonUp"
                MouseMove="Canvas_MouseMove"
                SnapsToDevicePixels="True"/>
    </Grid>
</Window>