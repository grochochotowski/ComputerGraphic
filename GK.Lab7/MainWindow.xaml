<Window x:Class="GK.Lab7.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:local="clr-namespace:GK.Lab7"
  mc:Ignorable="d"
  Title="Lab 7 - 2D Transformations" Height="450" Width="970"
  DataContext="{Binding RelativeSource={RelativeSource Self}}">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="100"/>
      <ColumnDefinition Width="100"/>
      <ColumnDefinition Width="100"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <StackPanel Grid.Column="0">
      <Button Content="Save" Click="Save_Click"/>
      <Button Content="Load" Click="Load_Click"/>
      <Separator/>
      <GroupBox Header="Tools">
        <StackPanel Orientation="Vertical">
          <RadioButton Content="Cursor" GroupName="Tools"
            Checked="Tools_Checked" x:Name="CursorRadioButton"/>
          <RadioButton Content="Translate" GroupName="Tools"
            Checked="Tools_Checked" x:Name="TranslationRadioButton"/>
          <RadioButton Content="Rotate" GroupName="Tools"
            Checked="Tools_Checked" x:Name="RotationRadioButton"/>
          <RadioButton Content="Scale" GroupName="Tools"
            Checked="Tools_Checked" x:Name="ScalingRadioButton"/>
        </StackPanel>
      </GroupBox>
      <StackPanel x:Name="PointStackPanel">
        <Label Content="Point X"/>
        <TextBox x:Name="PointXTextBox"
          Text="{Binding TransformationPointXString, Mode=TwoWay}"/>
        <Label Content="Point Y"/>
        <TextBox x:Name="PointYTextBox"
          Text="{Binding TransformationPointYString, Mode=TwoWay}"/>
      </StackPanel>
      <StackPanel x:Name="TranslationStackPanel">
        <Label Content="Vector X"/>
        <TextBox x:Name="TranslationVectorXTextBox"/>
        <Label Content="Vector Y"/>
        <TextBox x:Name="TranslationVectorYTextBox"/>
      </StackPanel>
      <StackPanel x:Name="RotationStackPanel">
        <Label Content="Angle (degrees)"/>
        <TextBox x:Name="RotationAngleTextBox"/>
      </StackPanel>
      <StackPanel x:Name="ScalingStackPanel">
        <Label Content="Scale X"/>
        <TextBox x:Name="ScalingCoefficientXTextBox"/>
        <Label Content="Scale Y"/>
        <TextBox x:Name="ScalingCoefficientYTextBox"/>
      </StackPanel>
      <Button Content="Perform" x:Name="PerformButton" Click="Perform_Click"/>
    </StackPanel>

    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="auto"/>
        <RowDefinition Height="auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Button Grid.Row="0" Content="Add Polygon" Click="AddPolygon_Click"/>

      <Button Grid.Row="1" Content="Delete Polygon" Click="DeleteSelectedPolygon_Click">
        <Button.Style>
          <Style TargetType="Button">
            <Setter Property="IsEnabled" Value="True"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding SelectedPolygonIndex}" Value="-1">
                <Setter Property="IsEnabled" Value="False"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Button.Style>
      </Button>

      <ListView Grid.Row="2" x:Name="PolygonsListView"
        SelectedIndex="{Binding SelectedPolygonIndex, Mode=TwoWay}"
        ItemsSource="{Binding Polygons}">
        <ListView.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Vertices.Count, StringFormat={}{0} vertices}"/>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </Grid>

    <Grid Grid.Column="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="auto"/>
        <RowDefinition Height="auto"/>
        <RowDefinition Height="auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Label Grid.Column="0" Grid.Row="0" Content="X" HorizontalContentAlignment="Center"/>
      <TextBox Grid.Column="0" Grid.Row="1" x:Name="XTextBox"/>

      <Label Grid.Column="1" Grid.Row="0" Content="Y" HorizontalContentAlignment="Center"/>
      <TextBox Grid.Column="1" Grid.Row="1" x:Name="YTextBox"/>

      <Button Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2" Content="Add Vertex" Click="AddVertex_Click"/>

      <ScrollViewer Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="3">
        <ItemsControl ItemsSource="{Binding ElementName=PolygonsListView,
          Path=SelectedItem.Vertices}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderThickness="1" ClipToBounds="True">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                        <Setter Property="BorderBrush" Value="Red"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBox Grid.Column="0" Text="{Binding X, Mode=TwoWay,
                    UpdateSourceTrigger=LostFocus}"/>
                  <TextBox Grid.Column="1" Text="{Binding Y, Mode=TwoWay,
                    UpdateSourceTrigger=LostFocus}"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Grid>

    <Border Grid.Column="3" BorderThickness="1" BorderBrush="Black" ClipToBounds="True">
      <Image x:Name="ImageControl" Height="400" Width="670"
        MouseLeftButtonDown="Image_MouseLeftButtonDown"
        MouseLeftButtonUp="Image_MouseLeftButtonUp"
        MouseMove="Image_MouseMove"
        MouseRightButtonDown="Image_MouseRightButtonDown"
        MouseDown="Image_MouseDown"/>
    </Border> 
  </Grid>
</Window>
