<Window x:Class="GK.Lab2.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PPM Viewer"
        Width="1200" Height="800"
        WindowStartupLocation="CenterScreen"
        MouseWheel="Window_MouseWheel"
        MouseDown="Window_MouseDown">

    <Grid Background="#222">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- MENU BAR -->
        <Menu Grid.Row="0">
            <MenuItem Header="File">
                <MenuItem Header="Open..." Click="Open_Click"/>
                <MenuItem Header="Save as JPEG..." Click="Save_Click"/>
            </MenuItem>
        </Menu>

        <!-- MAIN IMAGE PANEL -->
        <Border Grid.Row="1" BorderBrush="White" BorderThickness="1" Background="Black">

            <Grid>

                <!-- PLACEHOLDER -->
                <TextBlock Name="PlaceholderText"
                           Text="Open an image..."
                           Foreground="#BBBBBB"
                           FontSize="28"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Visible"/>

                <!-- SCROLL VIEWER (ZOOM & PAN) -->
                <ScrollViewer Name="ImageScroll"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              PreviewMouseWheel="ScrollViewer_PreviewMouseWheel"
                              Visibility="Collapsed">

                    <Grid>
                        <Image Name="Image"
                               Stretch="None"
                               MouseMove="Image_MouseMove"
                               MouseLeftButtonDown="Image_MouseLeftButtonDown"
                               MouseLeftButtonUp="Image_MouseLeftButtonUp"
                               RenderTransformOrigin="0,0"
                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                               >

                            <Image.RenderTransform>
                                <MatrixTransform/>
                            </Image.RenderTransform>

                        </Image>
                    </Grid>
                </ScrollViewer>

            </Grid>
        </Border>

        <!-- STATUS BAR -->
        <DockPanel Grid.Row="2" Background="#111" Height="35" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Margin="10 0">
                <TextBlock Text="X:" Foreground="White" Margin="0 0 5 0"/>
                <TextBox Name="XTextBox" Width="50" IsReadOnly="True" Margin="0 0 10 0"/>

                <TextBlock Text="Y:" Foreground="White" Margin="0 0 5 0"/>
                <TextBox Name="YTextBox" Width="50" IsReadOnly="True" Margin="0 0 10 0"/>

                <TextBlock Text="R:" Foreground="White" Margin="0 0 5 0"/>
                <TextBox Name="RTextBox" Width="50" IsReadOnly="True" Margin="0 0 10 0"/>

                <TextBlock Text="G:" Foreground="White" Margin="0 0 5 0"/>
                <TextBox Name="GTextBox" Width="50" IsReadOnly="True" Margin="0 0 10 0"/>

                <TextBlock Text="B:" Foreground="White" Margin="0 0 5 0"/>
                <TextBox Name="BTextBox" Width="50" IsReadOnly="True" Margin="0 0 10 0"/>
            </StackPanel>

            <TextBlock Name="ScaleTextBlock"
                       Foreground="White"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       Margin="0 0 20 0"
                       DockPanel.Dock="Right"
                       Text="100%"/>
        </DockPanel>

    </Grid>
</Window>
