<Window x:Class="GK.Lab3.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GK.Lab3"
        mc:Ignorable="d"
        Title="GK Lab 3 - Michal Grochowski" Height="800" Width="1200">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- MENU -->
        <Border x:Name="MenuPanel"
                Grid.Row="0">

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left">

                <Button Content="Conversion"
                        Width="140" Margin="5"
                        Click="Conversion_Click"/>

                <Button Content="RGB Cube"
                        Width="140" Margin="5"
                        Click="Cube_Click"/>
                
            </StackPanel>
        </Border>

        <!-- CONTENT -->
        <ContentControl x:Name="ContentArea"
                        Grid.Row="1"/>
    </Grid>
</Window>